<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- 版本号 -->
        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="版本: 0.1.0"
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- LLM 配置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_llm_config"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_llm_api_key"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_hint_api_key"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_llm_base_url"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_hint_base_url"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_llm_model_name"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_model_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_hint_model_name"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 测试连接按钮 -->
        <Button
            android:id="@+id/btn_test_llm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_btn_test_llm"
            android:layout_marginTop="16dp"
            style="?android:attr/borderlessButtonStyle" />

        <!-- 飞书配置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_feishu_config"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_feishu_app_id"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_feishu_app_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_hint_feishu_app_id"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_feishu_app_secret"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_feishu_app_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_hint_feishu_app_secret"
            android:inputType="text"
            android:maxLines="1" />

        <!-- 测试飞书连接按钮 -->
        <Button
            android:id="@+id/btn_test_feishu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测试飞书连接"
            android:layout_marginTop="16dp"
            style="?android:attr/borderlessButtonStyle" />

        <!-- 发送测试消息按钮 -->
        <Button
            android:id="@+id/btn_send_test_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发送测试消息"
            android:layout_marginTop="8dp"
            style="?android:attr/borderlessButtonStyle" />

        <!-- 检查通知权限按钮 -->
        <Button
            android:id="@+id/btn_check_notification_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="检查通知权限"
            android:layout_marginTop="8dp"
            style="?android:attr/borderlessButtonStyle" />

        <!-- 消息日志 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="消息日志"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <ScrollView
            android:id="@+id/sv_message_log"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#F5F5F5"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_message_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无消息"
                android:textSize="12sp"
                android:textColor="#666666"
                android:fontFamily="monospace" />
        </ScrollView>

        <!-- 保存按钮 -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_btn_save"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
